# Application
APP_NAME=Resume Analysis Agent
DEBUG=false

# Database
DATABASE_URL=mysql+pymysql://<db_user>:<db_password>@<db_host>:3306/<db_name>?charset=utf8mb4

# Redis
REDIS_URL=redis://:<redis_password>@<redis_host>:6379/1

# Qdrant
QDRANT_URL=http://<qdrant_host>:6333

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=<openai_compatible_api_key>
OPENAI_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com/v1

# Claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Local Model
LOCAL_MODEL_PATH=

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# Resume Source API
RESUME_SOURCE_API_BASE_URL=
RESUME_SOURCE_API_TOKEN=
RESUME_SOURCE_API_TIMEOUT=30

# Celery
CELERY_BROKER_URL=redis://:<redis_password>@<redis_host>:6379/1
CELERY_RESULT_BACKEND=redis://:<redis_password>@<redis_host>:6379/2

# OBS
OBS_ACCESS_KEY=<obs_access_key>
OBS_SECRET_KEY=<obs_secret_key>
OBS_BUCKET=<obs_bucket>
OBS_HOST=obs.cn-south-1.myhuaweicloud.com
OBS_URL_EXPIRE_SECONDS=3600

# Application
APP_NAME=Resume Analysis Agent
DEBUG=true

# Database (SQLAlchemy URL)
# Local Docker MySQL:
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/resume_agent?charset=utf8mb4
# Remote MySQL example:
# DATABASE_URL=mysql+pymysql://root:your_password@test.derkee.com:3307/uat?charset=utf8mb4

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333

# LLM Configuration
# Allowed: local, openai, claude
# Use `openai` when talking to DeepSeek's OpenAI-compatible API.
LLM_PROVIDER=openai

# DeepSeek / OpenAI
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com/v1

# Claude (optional)
CLAUDE_API_KEY=sk-ant-xxx
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Local Model (optional)
LOCAL_MODEL_PATH=/path/to/models/Qwen2.5-14B-Instruct

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# Resume Source API
RESUME_SOURCE_API_BASE_URL=
RESUME_SOURCE_API_TOKEN=
RESUME_SOURCE_API_TIMEOUT=30

# OBS
OBS_ACCESS_KEY=
OBS_SECRET_KEY=
OBS_BUCKET=
OBS_HOST=
OBS_URL_EXPIRE_SECONDS=900

# Local Office Conversion / OCR
LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

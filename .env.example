# Application
APP_NAME=Resume Analysis Agent
DEBUG=true

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_agent

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333

# LLM Configuration
# 可选值: local, openai, claude
# 使用 DeepSeek 时设置为 openai（兼容 OpenAI 格式）
LLM_PROVIDER=openai

# DeepSeek / OpenAI 配置
# DeepSeek: base_url=https://api.deepseek.com/v1, model=deepseek-chat
# OpenAI: base_url=https://api.openai.com/v1, model=gpt-4o
OPENAI_API_KEY=sk-4a54388294bd4f2d8fed498013003340
OPENAI_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com/v1

# Claude (optional)
CLAUDE_API_KEY=sk-ant-xxx
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Local Model (optional - 需要 GPU)
LOCAL_MODEL_PATH=/path/to/models/Qwen2.5-14B-Instruct

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

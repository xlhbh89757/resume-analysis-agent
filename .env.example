# Application
APP_NAME=Resume Analysis Agent
DEBUG=true

# Database (SQLAlchemy URL)
# Local Docker MySQL:
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/resume_agent?charset=utf8mb4
# Remote MySQL example:
# DATABASE_URL=mysql+pymysql://root:your_password@test.derkee.com:3307/uat?charset=utf8mb4

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333

# LLM Configuration
# 可选值: local, openai, claude
# 使用 DeepSeek 时设置为 openai（兼容 OpenAI 格式）
LLM_PROVIDER=openai

# DeepSeek / OpenAI 配置
# DeepSeek: base_url=https://api.deepseek.com/v1, model=deepseek-chat
# OpenAI: base_url=https://api.openai.com/v1, model=gpt-4o
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXX
OPENAI_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com/v1

# Claude (optional)
CLAUDE_API_KEY=sk-ant-xxx
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Local Model (optional - 需要 GPU)
LOCAL_MODEL_PATH=/path/to/models/Qwen2.5-14B-Instruct

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
